# Prismarity environment variables
# Copy to .env.local for local dev; set the same keys in your host's dashboard
# (Vercel → Project → Settings → Environment Variables) for production.

# ── Public origin ────────────────────────────────────────────────────────────
# The deployed site's base URL. Baked in at BUILD time (NEXT_PUBLIC_*), and used
# to construct OAuth redirect URIs — it MUST exactly match the deployment origin
# AND the redirect URLs registered in the Twitch/Kick apps.
#   local:  http://localhost:3000
#   prod:   https://your-app.vercel.app   (or your custom domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Secrets (required) ───────────────────────────────────────────────────────
# Encrypts the whole session (AES-256-GCM). Sessions are STATELESS — the user's
# connections + tokens live inside an encrypted cookie, no server store — so this
# key both encrypts tokens AND secures the session. Generate: openssl rand -base64 32
#   • Must decode to exactly 32 bytes.
#   • Name must match exactly (a typo silently breaks decryption → nobody stays logged in).
#   • Rotating it invalidates every existing session (everyone must re-login).
TOKEN_ENCRYPTION_KEY=

# (SESSION_SECRET is no longer used — stateless sessions are secured by
# TOKEN_ENCRYPTION_KEY above. Safe to omit.)

# ── Twitch OAuth ─────────────────────────────────────────────────────────────
# TWITCH_CLIENT_ID is optional (a shared default is built in); set it to use your
# own Twitch app. TWITCH_CLIENT_SECRET is recommended for reliable token refresh.
# Register redirect URI: <NEXT_PUBLIC_BASE_URL>/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Kick OAuth ───────────────────────────────────────────────────────────────
# Register redirect URI: <NEXT_PUBLIC_BASE_URL>/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ── Beacon KV (optional) ─────────────────────────────────────────────────────
# The beacon (browser-extension → dashboard channel follow) is the one feature
# that needs shared server state, so it uses Upstash Redis. Leave these unset and
# the beacon is simply inert; set them (Upstash free tier, or Vercel's Upstash
# integration auto-injects them) to enable it. Everything else runs without a KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
