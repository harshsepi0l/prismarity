# Copy this file to .env.local and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything below is SERVER-SIDE ONLY — never prefix these with NEXT_PUBLIC_.

# ── Twitch OAuth ─────────────────────────────────────────
# Register an app at https://dev.twitch.tv/console/apps (see README).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# ── Secrets ──────────────────────────────────────────────
# Signs the session cookie.            Generate: openssl rand -hex 32
SESSION_SECRET=
# 32-byte key (base64) for AES-256-GCM token encryption at rest.
#                                      Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
